    <!-- Tutorial -->
    <string name="tutorial_page_welcome_title">欢迎使用酷狼输入法</string>
    <string name="tutorial_page_welcome_description">酷狼输入法是一款高级安卓物理键盘输入法，支持修饰键、LED指示灯和导航模式。</string>
    <string name="tutorial_page_enable_title">启用酷狼输入法</string>
    <string name="tutorial_page_enable_description">首先，您需要在安卓设置中启用酷狼输入法。点击下方按钮打开设置。</string>
    <string name="tutorial_page_select_title">选择酷狼输入法</string>
    <string name="tutorial_page_select_description">启用酷狼输入法后，将其设为默认键盘。点击下方按钮选择输入法。</string>
    <string name="tutorial_page_led_title">LED指示灯</string>
    <string name="tutorial_page_led_description">酷狼输入法在状态栏显示5个LED指示修饰键状态：\n\n• Shift：激活时蓝色，锁定时红色\n• SYM：表情符号蓝色，特殊字符红色\n• Ctrl：激活时蓝色，锁定时红色\n• Alt：激活时蓝色，锁定时红色\n\n灰色LED表示修饰键关闭。</string>
    <string name="tutorial_page_customization_description">酷狼输入法提供丰富的自定义选项：\n\n• 可自定义键盘布局\n• 启动快捷方式\n• 自动更正\n• 导航模式自定义映射\n\n探索设置找到最适合您的配置！</string>
    <string name="tutorial_page_ready_description">您现在可以使用酷狼输入法了！记住您可以随时返回设置进一步自定义键盘。</string>
