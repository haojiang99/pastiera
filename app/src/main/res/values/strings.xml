    <string name="tutorial_page_welcome_title">Welcome to Coolwulf IME</string>
    <string name="tutorial_page_welcome_description">Coolwulf IME is an advanced physical keyboard for Android with support for modifiers, LED indicators, and navigation mode.</string>
    <string name="tutorial_page_enable_title">Enable Coolwulf IME</string>
    <string name="tutorial_page_enable_description">To get started, you need to enable Coolwulf IME as an input method in Android Settings. Tap the button below to open settings.</string>
    <string name="tutorial_page_select_title">Select Coolwulf IME</string>
    <string name="tutorial_page_select_description">After enabling Coolwulf IME, select it as your default keyboard. Tap the button below to choose the input method.</string>
    <string name="tutorial_page_led_title">LED Indicator</string>
    <string name="tutorial_page_led_description">Coolwulf IME shows 5 LEDs in the status bar that indicate modifier status:\n\n• Shift: blue when active, red when locked\n• SYM: blue for emoji, red for special characters\n• Ctrl: blue when active, red when locked\n• Alt: blue when active, red when locked\n\nGray LEDs indicate the modifier is off.</string>
    <string name="tutorial_page_nav_mode_title">Nav Mode</string>
    <string name="tutorial_page_nav_mode_description">Nav Mode allows you to navigate using letter keys as shortcuts.\n\nTo activate:\n• Press Ctrl twice quickly\n• Letter keys are mapped to navigation functions\n• Press Ctrl again to deactivate\n\nYou can customize the mappings in advanced settings.</string>
    <string name="tutorial_page_customization_title">Customization</string>
    <string name="tutorial_page_customization_description">Coolwulf IME offers many customization options:\n\n• Customizable keyboard layouts\n• Launcher shortcuts\n• Auto-correction\n• Custom mappings for Nav Mode\n\nExplore the settings to find the perfect configuration for you!</string>
    <string name="tutorial_page_ready_title">Ready to Start</string>
    <string name="tutorial_page_ready_description">You are now ready to use Coolwulf IME! Remember that you can always return to settings to further customize the keyboard to your needs.</string>
